# frozen_string_literal: true

source "https://rubygems.org"

group :development do
  gem 'aigcm'
  gem 'debug_me'
  gem 'fasterer'
  gem 'flay'
  gem 'flog'
  gem 'reek'
  gem 'rubocop'
  gem 'simplecov_lcov_formatter'
  gem 'deep-cover', require: false

  # Not an aia dependency: users bring it with --require shared_tools.
  # Listed here so bin/aia can load it and its deps for examples 18 and 30.
  gem 'shared_tools', '>= 0.7.1'
  gem 'dentaku' # shared_tools CalculatorTool (an optional shared_tools dependency)
end

gemspec

gem 'robot_lab', path: '../robot_lab'
# Agent-CLI providers (claude_code, codex, copilot): not aia dependencies —
# users install the ruby_llm-providers-* gem they want. Listed here so
# bin/aia can resolve `--model claude_code/opus` against the local checkouts.
gem 'ruby_llm-providers-claude_code', path: '../../ruby_llm-providers_project/claude_code'
gem 'ruby_llm-providers-codex',       path: '../../ruby_llm-providers_project/codex'
gem 'ruby_llm-providers-copilot',     path: '../../ruby_llm-providers_project/copilot'
gem 'ractor_queue', path: '../../../ractor_queue'
